{{> head}}
<body class="app-bg">
{{> sidebar}}
<main class="main-content">
  <header class="topbar"><div><p class="text-xs font-semibold uppercase tracking-wider text-cyan-700">AquaPiol / Overview</p><h1 class="page-title">Dashboard</h1><p class="text-sm text-slate-500">Here is your station's financial overview.</p></div><div class="text-right"><p class="text-sm font-semibold text-slate-700">{{currentUser.name}}</p><p class="text-xs capitalize text-slate-500">{{currentUser.role}} · {{today}}</p></div></header>
  {{> flash}}
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="stat-card"><div class="stat-label">Total Income</div><div class="stat-value">₱{{income}}</div><div class="stat-foot">Recorded customer receipts</div></div>
    <div class="stat-card"><div class="stat-label">Total Expenses</div><div class="stat-value">₱{{expenses}}</div><div class="stat-foot">Recorded operating costs</div></div>
    <div class="stat-card"><div class="stat-label">Net Cash Difference</div><div class="stat-value">₱{{net}}</div><div class="stat-foot">Income less expenses</div></div>
    <div class="stat-card"><div class="stat-label">Invoices</div><div class="stat-value">{{invoiceCount}}</div><div class="stat-foot">Total recorded invoices</div></div>
  </section>
  <section class="mt-6 grid gap-5 xl:grid-cols-3">
    <div class="panel xl:col-span-2"><div class="panel-heading"><div><h2 class="section-title">Income vs Expenses</h2><p class="text-xs text-slate-500">Monthly financial activity · Last 6 months</p></div><span class="pill">Analytics</span></div><div class="chart-wrap"><canvas id="financeChart"></canvas></div></div>
    <div class="panel"><div class="panel-heading"><div><h2 class="section-title">Quick Actions</h2><p class="text-xs text-slate-500">Manage daily accounting</p></div></div><div class="space-y-3"><a class="quick-link" href="/transactions">＋ <span><b>Record transaction</b><small>Add income or expense</small></span></a><a class="quick-link" href="/accounts">▤ <span><b>Chart of accounts</b><small>Review financial accounts</small></span></a><a class="quick-link" href="/reports">▥ <span><b>View reports</b><small>Check financial summary</small></span></a></div><div class="mt-6 rounded-xl bg-cyan-50 p-4"><p class="text-xs font-semibold text-cyan-800">ACTIVE USERS</p><p class="mt-1 text-2xl font-bold text-slate-900">{{userCount}}</p><p class="text-xs text-slate-500">Registered system accounts</p></div></div>
  </section>
  <section class="mt-6 grid gap-5 lg:grid-cols-2">
    <div class="panel"><div class="panel-heading"><h2 class="section-title">Recent Payments</h2><a class="text-xs font-semibold text-cyan-700" href="/transactions">View all</a></div><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Date</th><th>Type</th><th>Amount</th></tr></thead><tbody>{{#each recentPayments}}<tr><td>{{paymentDate}}</td><td><span class="capitalize">{{paymentType}}</span></td><td>₱{{amount}}</td></tr>{{else}}<tr><td colspan="3" class="empty-cell">No payment records yet.</td></tr>{{/each}}</tbody></table></div></div>
    <div class="panel"><div class="panel-heading"><h2 class="section-title">Recent Expenses</h2><a class="text-xs font-semibold text-cyan-700" href="/transactions">View all</a></div><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Date</th><th>Expense</th><th>Amount</th></tr></thead><tbody>{{#each recentExpenses}}<tr><td>{{expenseDate}}</td><td>{{expenseName}}</td><td>₱{{amount}}</td></tr>{{else}}<tr><td colspan="3" class="empty-cell">No expense records yet.</td></tr>{{/each}}</tbody></table></div></div>
  </section>
  <script>
    const labels = {{{chartLabels}}}; const incomeData = {{{chartIncome}}}; const expenseData = {{{chartExpenses}}};
    new Chart(document.getElementById('financeChart'), { type:'bar', data:{labels,datasets:[{label:'Income',data:incomeData,backgroundColor:'#0891b2',borderRadius:6},{label:'Expenses',data:expenseData,backgroundColor:'#f59e0b',borderRadius:6}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}},scales:{y:{beginAtZero:true,ticks:{callback:v=>'₱'+v.toLocaleString()}}}}});
  </script>
{{> footer}}
