{{> head}}
<body class="app-bg">{{> sidebar}}<main class="main-content">
<header class="topbar"><div><p class="eyebrow">AquaPiol / Accounting</p><h1 class="page-title">Chart of Accounts</h1><p class="text-sm text-slate-500">Organize your assets, liabilities, equity, revenue, and expenses.</p></div></header>{{> flash}}
<div class="grid gap-5 xl:grid-cols-3"><section class="panel xl:col-span-2"><div class="panel-heading"><h2 class="section-title">Account List</h2><span class="pill">{{accounts.length}} accounts</span></div><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Code</th><th>Account Name</th><th>Type</th><th>Status</th></tr></thead><tbody>{{#each accounts}}<tr><td class="font-semibold">{{accountCode}}</td><td>{{accountName}}</td><td class="capitalize">{{accountType}}</td><td>{{#if isActive}}<span class="status-active">Active</span>{{else}}Inactive{{/if}}</td></tr>{{else}}<tr><td colspan="4" class="empty-cell">No accounts added yet.</td></tr>{{/each}}</tbody></table></div></section>
<section class="panel"><h2 class="section-title mb-4">Add Account</h2><form action="/accounts" method="POST" class="space-y-4"><div><label class="form-label">Account Code</label><input class="form-input" name="accountCode" placeholder="e.g. 1000" required></div><div><label class="form-label">Account Name</label><input class="form-input" name="accountName" placeholder="e.g. Cash on Hand" required></div><div><label class="form-label">Account Type</label><select class="form-input" name="accountType" required><option value="asset">Asset</option><option value="liability">Liability</option><option value="equity">Equity</option><option value="revenue">Revenue</option><option value="expense">Expense</option></select></div><div><label class="form-label">Description</label><textarea class="form-input" name="description" rows="3"></textarea></div><button class="primary-btn w-full">Save Account</button></form></section></div>
{{> footer}}
