{{> head}}
<body class="app-bg">{{> sidebar}}<main class="main-content">
<header class="topbar"><div><p class="eyebrow">AquaPiol / Sales Accounting</p><h1 class="page-title">Invoices</h1><p class="text-sm text-slate-500">Create customer invoices and review billing records.</p></div></header>{{> flash}}
<div class="grid gap-5 xl:grid-cols-3"><section class="panel xl:col-span-2"><h2 class="section-title mb-3">Invoice Records</h2><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Invoice #</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody>{{#each invoices}}<tr><td class="font-semibold">{{invoiceNumber}}</td><td>{{Customer.name}}</td><td>{{invoiceDate}}</td><td>₱{{totalAmount}}</td><td class="capitalize">{{status}}</td></tr>{{else}}<tr><td colspan="5" class="empty-cell">No invoices created.</td></tr>{{/each}}</tbody></table></div></section>
<section class="panel"><h2 class="section-title mb-4">Create Invoice</h2><form action="/invoices" method="POST" class="space-y-3"><div><label class="form-label">Customer</label><select class="form-input" name="customerId" required><option value="">Select customer</option>{{#each customers}}<option value="{{id}}">{{name}}</option>{{/each}}</select></div><div><label class="form-label">Description</label><input class="form-input" name="description" placeholder="e.g. Water refill order" required></div><div class="grid grid-cols-2 gap-3"><div><label class="form-label">Quantity</label><input class="form-input" name="quantity" type="number" min="1" value="1" required></div><div><label class="form-label">Unit Price</label><input class="form-input" name="unitPrice" type="number" min="0" step="0.01" required></div></div><div><label class="form-label">Tax Amount</label><input class="form-input" name="taxAmount" type="number" min="0" step="0.01" value="0"></div><div class="grid grid-cols-2 gap-3"><div><label class="form-label">Invoice Date</label><input class="form-input" name="invoiceDate" type="date" required></div><div><label class="form-label">Due Date</label><input class="form-input" name="dueDate" type="date"></div></div><button class="primary-btn w-full">Create Invoice</button></form></section></div>
{{> footer}}
