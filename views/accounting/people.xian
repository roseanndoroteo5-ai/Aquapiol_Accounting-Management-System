{{> head}}
<body class="app-bg">{{> sidebar}}<main class="main-content">
<header class="topbar"><div><p class="eyebrow">AquaPiol / Records</p><h1 class="page-title">{{peopleTitle}}</h1><p class="text-sm text-slate-500">Manage your station's {{peopleType}} records.</p></div></header>{{> flash}}
<div class="grid gap-5 xl:grid-cols-3"><section class="panel xl:col-span-2"><div class="panel-heading"><h2 class="section-title">{{peopleTitle}} List</h2><span class="pill">{{people.length}} records</span></div><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th></tr></thead><tbody>{{#each people}}<tr><td class="font-semibold">{{name}}</td><td>{{email}}</td><td>{{phone}}</td><td>{{address}}</td></tr>{{else}}<tr><td colspan="4" class="empty-cell">No {{peopleType}} records yet.</td></tr>{{/each}}</tbody></table></div></section>
<section class="panel"><h2 class="section-title mb-4">Add {{peopleType}}</h2><form action="/{{peopleType}}s" method="POST" class="space-y-4"><div><label class="form-label">Name</label><input class="form-input" name="name" required></div>{{#if (eq peopleType 'supplier')}}<div><label class="form-label">Contact Person</label><input class="form-input" name="contactPerson"></div>{{/if}}<div><label class="form-label">Email</label><input class="form-input" name="email" type="email"></div><div><label class="form-label">Phone</label><input class="form-input" name="phone"></div><div><label class="form-label">Address</label><textarea class="form-input" name="address" rows="3"></textarea></div><button class="primary-btn w-full">Save {{peopleType}}</button></form></section></div>
{{> footer}}
