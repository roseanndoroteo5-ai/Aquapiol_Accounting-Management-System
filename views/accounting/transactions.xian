{{> head}}
<body class="app-bg">{{> sidebar}}<main class="main-content">
<header class="topbar"><div><p class="eyebrow">AquaPiol / Accounting</p><h1 class="page-title">Transactions</h1><p class="text-sm text-slate-500">Record customer receipts and station operating expenses.</p></div></header>{{> flash}}
<div class="grid gap-5 xl:grid-cols-2"><section class="panel"><h2 class="section-title mb-4">Record Payment / Income</h2><form action="/payments" method="POST" class="grid gap-4 sm:grid-cols-2"><div><label class="form-label">Transaction Type</label><select class="form-input" name="paymentType"><option value="received">Income received</option><option value="paid">Payment paid</option></select></div><div><label class="form-label">Payment Method</label><select class="form-input" name="paymentMethod"><option value="cash">Cash</option><option value="bank">Bank</option><option value="e-wallet">E-wallet</option></select></div><div><label class="form-label">Amount (₱)</label><input class="form-input" name="amount" type="number" min="0.01" step="0.01" required></div><div><label class="form-label">Payment Date</label><input class="form-input" name="paymentDate" type="date" required></div><div class="sm:col-span-2"><label class="form-label">Reference (optional)</label><input class="form-input" name="paymentReference"></div><div class="sm:col-span-2"><label class="form-label">Notes</label><textarea class="form-input" name="notes" rows="2"></textarea></div><div class="sm:col-span-2"><button class="primary-btn w-full">Save Payment</button></div></form></section>
<section class="panel"><h2 class="section-title mb-4">Record Expense</h2><form action="/expenses" method="POST" class="grid gap-4 sm:grid-cols-2"><div class="sm:col-span-2"><label class="form-label">Expense Name</label><input class="form-input" name="expenseName" placeholder="e.g. Electricity bill" required></div><div><label class="form-label">Amount (₱)</label><input class="form-input" name="amount" type="number" min="0.01" step="0.01" required></div><div><label class="form-label">Expense Date</label><input class="form-input" name="expenseDate" type="date" required></div><div class="sm:col-span-2"><label class="form-label">Payment Method</label><select class="form-input" name="paymentMethod"><option value="cash">Cash</option><option value="bank">Bank</option><option value="e-wallet">E-wallet</option></select></div><div class="sm:col-span-2"><label class="form-label">Description</label><textarea class="form-input" name="description" rows="2"></textarea></div><div class="sm:col-span-2"><button class="primary-btn w-full">Save Expense</button></div></form></section></div>
<div class="panel mt-5"><h2 class="section-title mb-3">Payment History</h2><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Date</th><th>Reference</th><th>Type</th><th>Method</th><th>Amount</th></tr></thead><tbody>{{#each payments}}<tr><td>{{paymentDate}}</td><td>{{paymentReference}}</td><td class="capitalize">{{paymentType}}</td><td>{{paymentMethod}}</td><td>₱{{amount}}</td></tr>{{else}}<tr><td colspan="5" class="empty-cell">No payments recorded.</td></tr>{{/each}}</tbody></table></div></div>
<div class="panel mt-5"><h2 class="section-title mb-3">Expense History</h2><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Date</th><th>Expense</th><th>Method</th><th>Amount</th></tr></thead><tbody>{{#each expenses}}<tr><td>{{expenseDate}}</td><td>{{expenseName}}</td><td>{{paymentMethod}}</td><td>₱{{amount}}</td></tr>{{else}}<tr><td colspan="4" class="empty-cell">No expenses recorded.</td></tr>{{/each}}</tbody></table></div></div>
{{> footer}}
