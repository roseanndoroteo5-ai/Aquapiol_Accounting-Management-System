{{> head}}
<body class="app-bg">{{> sidebar}}<main class="main-content">
<header class="topbar"><div><p class="eyebrow">AquaPiol / Administration</p><h1 class="page-title">User Management</h1><p class="text-sm text-slate-500">Create and manage administrator and staff access.</p></div></header>{{> flash}}
<div class="grid gap-5 xl:grid-cols-3"><section class="panel xl:col-span-2"><h2 class="section-title mb-3">System Users</h2><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Action</th></tr></thead><tbody>{{#each users}}<tr><td>{{name}}</td><td>{{email}}</td><td class="capitalize">{{role}}</td><td>{{#if isActive}}<span class="status-active">Active</span>{{else}}<span class="status-inactive">Inactive</span>{{/if}}</td><td><form method="POST" action="/users/{{id}}/toggle"><button class="text-xs font-semibold text-cyan-700">{{#if isActive}}Deactivate{{else}}Activate{{/if}}</button></form></td></tr>{{else}}<tr><td colspan="5" class="empty-cell">No users found.</td></tr>{{/each}}</tbody></table></div></section>
<section class="panel"><h2 class="section-title mb-4">Add User</h2><form action="/users" method="POST" class="space-y-4"><div><label class="form-label">Full Name</label><input class="form-input" name="name" required></div><div><label class="form-label">Email</label><input class="form-input" name="email" type="email" required></div><div><label class="form-label">Temporary Password</label><input class="form-input" name="password" type="password" minlength="8" required></div><div><label class="form-label">Role</label><select class="form-input" name="role"><option value="staff">Staff</option><option value="admin">Admin</option></select></div><button class="primary-btn w-full">Create User</button></form><p class="mt-3 text-xs text-slate-500">Only administrators can access this page.</p></section></div>
{{> footer}}
