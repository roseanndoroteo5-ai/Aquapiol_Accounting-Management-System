{{> head}}
<body class="app-bg">{{> sidebar}}<main class="main-content">
<header class="topbar"><div><p class="eyebrow">AquaPiol / Accounting</p><h1 class="page-title">Financial Reports</h1><p class="text-sm text-slate-500">Summary of recorded income, expenses, and account balances.</p></div><button class="secondary-btn" onclick="window.print()">Print Report</button></header>{{> flash}}
<div class="grid gap-4 md:grid-cols-3"><div class="stat-card"><div class="stat-label">Total Income</div><div class="stat-value">₱{{income}}</div></div><div class="stat-card"><div class="stat-label">Total Expenses</div><div class="stat-value">₱{{expenses}}</div></div><div class="stat-card"><div class="stat-label">Net Difference</div><div class="stat-value">₱{{net}}</div></div></div>
<div class="panel mt-5"><h2 class="section-title mb-3">Chart of Accounts</h2><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th>Current Balance</th></tr></thead><tbody>{{#each accounts}}<tr><td>{{accountCode}}</td><td>{{accountName}}</td><td class="capitalize">{{accountType}}</td><td>₱{{balance}}</td></tr>{{else}}<tr><td colspan="4" class="empty-cell">No accounts available.</td></tr>{{/each}}</tbody></table></div></div>
<div class="panel mt-5"><h2 class="section-title mb-3">Recent Journal Entries</h2><div class="overflow-x-auto"><table class="data-table"><thead><tr><th>Reference</th><th>Date</th><th>Description</th><th>Status</th></tr></thead><tbody>{{#each journalEntries}}<tr><td>{{referenceNumber}}</td><td>{{entryDate}}</td><td>{{description}}</td><td class="capitalize">{{status}}</td></tr>{{else}}<tr><td colspan="4" class="empty-cell">No journal entries recorded.</td></tr>{{/each}}</tbody></table></div></div>
{{> footer}}
