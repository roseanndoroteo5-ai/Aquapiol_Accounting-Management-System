# Copy to .env or set these variables in your terminal before running the app.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=accounting_management
DB_USER=root
DB_PASSWORD=
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# Optional initial user passwords used only when the users table is empty:
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_PASSWORD=Staff@12345

# Module-to-module API security. Generate a long random value; never commit the real token.
API_BEARER_TOKEN=replace-with-a-long-random-api-token
# ID of an active Accounting user used as the creator for API-written records.
API_SERVICE_USER_ID=1
